#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if [[ -x "$ROOT/.venv/bin/python" ]]; then
  PYTHON="$ROOT/.venv/bin/python"
else
  PYTHON="python3"
fi

cd "$ROOT"
"$PYTHON" -m pip install -q build
rm -f "$SCRIPT_DIR"/*.whl
"$PYTHON" -m build --wheel --outdir "$SCRIPT_DIR" "$ROOT/packages/neo4j"
"$PYTHON" -m build --wheel --outdir "$SCRIPT_DIR" "$ROOT"
